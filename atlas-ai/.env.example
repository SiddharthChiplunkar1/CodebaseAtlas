# Python AI Service — Environment Variables
# Copy this file to .env and fill in your values

# ── LLM / Embeddings ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Database ──────────────────────────────────────────────────────────────────
# Points to the same Postgres instance as atlas-api
POSTGRES_URL=postgresql://atlas:atlas_secret@localhost:5432/atlas

# ── gRPC Server ───────────────────────────────────────────────────────────────
GRPC_PORT=50051

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
